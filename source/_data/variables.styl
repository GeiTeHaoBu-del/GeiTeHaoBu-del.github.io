// =====================================================================
// NexT Variable Override - Sage Green Theme (Light + Dark)
// =====================================================================

// --- Light mode colors ---
$body-bg-color                = #f8f7f4
$content-bg-color             = #ffffff
$card-bg-color                = #fafaf8

$text-color                   = #1b2e1f
$link-color                   = #2d6a4f
$link-hover-color             = #1b4332
$link-decoration-color        = rgba(45, 106, 79, 0.3)

$border-color                 = rgba(0, 0, 0, 0.08)

$selection-bg                 = #2d6a4f
$selection-color              = #fff

$menu-item-bg-color           = rgba(45, 106, 79, 0.06)

$theme-color                  = #2d6a4f

$blockquote-color             = #6b7c6f

$table-border-color           = rgba(0, 0, 0, 0.08)
$table-row-odd-bg-color       = #fafaf8
$table-row-hover-bg-color     = #f0efea

// Brand (light)
$brand-color                  = #2d6a4f
$brand-hover-color            = #1b4332
$subtitle-color               = #6b7c6f
$site-subtitle-color          = #6b7c6f

// Sidebar (light)
$sidebar-nav-color            = #6b7c6f
$sidebar-nav-hover-color      = #2d6a4f
$sidebar-highlight            = #2d6a4f
$site-author-name-color       = #1b2e1f
$site-description-color       = #6b7c6f
$site-state-item-name-color   = #95a89a

// Buttons (light)
$btn-default-bg               = rgba(45, 106, 79, 0.06)
$btn-default-color            = #2d6a4f
$btn-default-border-color     = rgba(45, 106, 79, 0.15)
$btn-default-hover-bg         = rgba(45, 106, 79, 0.1)
$btn-default-hover-color      = #1b4332
$btn-default-hover-border-color = #2d6a4f
$btn-default-radius           = 6px

// Pagination (light)
$pagination-link-bg           = #ffffff
$pagination-link-color        = #6b7c6f
$pagination-link-border       = rgba(0, 0, 0, 0.08)
$pagination-link-hover-bg     = rgba(45, 106, 79, 0.06)
$pagination-link-hover-color  = #2d6a4f
$pagination-link-hover-border = #2d6a4f
$pagination-active-bg         = rgba(45, 106, 79, 0.08)
$pagination-active-color      = #2d6a4f
$pagination-active-border     = #2d6a4f

// Headband
$headband-bg                  = linear-gradient(90deg, #1b4332, #2d6a4f, #1b4332)

// Tag cloud (light)
$tag-cloud-start              = #6b7c6f
$tag-cloud-end                = #2d6a4f

// Back to top (light)
$b2t-bg-color                 = #fafaf8
$b2t-color                    = #2d6a4f

// Badge (light)
$badge-background             = rgba(45, 106, 79, 0.08)
$badge-color                  = #2d6a4f

// --- Dark mode colors ---
$body-bg-color-dark           = #141a17
$content-bg-color-dark        = #1e2522
$card-bg-color-dark           = #1e2522

$text-color-dark              = #d8e8dc
$link-color-dark              = #52b788
$link-hover-color-dark        = #74c69d

$menu-item-bg-color-dark      = rgba(82, 183, 136, 0.08)

$theme-color-dark             = #52b788

$blockquote-color-dark        = #95a89a

$table-border-color-dark      = rgba(255, 255, 255, 0.06)
$table-row-odd-bg-color-dark  = #141a17
$table-row-hover-bg-color-dark = #2a332e

// Brand (dark)
$brand-color-dark             = #52b788
$brand-hover-color-dark       = #74c69d

// Buttons (dark)
$btn-default-bg-dark          = rgba(82, 183, 136, 0.08)
$btn-default-color-dark       = #52b788
$btn-default-border-color-dark = rgba(82, 183, 136, 0.2)
$btn-default-hover-bg-dark    = rgba(82, 183, 136, 0.15)
$btn-default-hover-color-dark = #74c69d
$btn-default-hover-border-color-dark = #52b788

// Pagination (dark)
$pagination-link-bg-dark      = #1e2522
$pagination-link-color-dark   = #95a89a
$pagination-link-border-dark  = rgba(255, 255, 255, 0.06)
$pagination-link-hover-bg-dark = rgba(82, 183, 136, 0.08)
$pagination-link-hover-color-dark = #52b788
$pagination-link-hover-border-dark = #52b788
$pagination-active-bg-dark    = rgba(82, 183, 136, 0.12)
$pagination-active-color-dark = #52b788
$pagination-active-border-dark = #52b788

// Tag cloud (dark)
$tag-cloud-start-dark         = #95a89a
$tag-cloud-end-dark           = #52b788

// Back to top (dark)
$b2t-bg-color-dark            = #1e2522
$b2t-color-dark               = #52b788

// Badge (dark)
$badge-background-dark        = rgba(82, 183, 136, 0.12)
$badge-color-dark             = #52b788

// --- Layout ---
$content-desktop-large        = 1200px
$content-desktop-largest      = 1400px

// Border radius (for Pisces)
$border-radius-inner          = 8px
$border-radius                = 8px
$box-shadow-inner             = 0 2px 8px rgba(0,0,0,0.06)
$box-shadow                   = 0 1px 4px rgba(0,0,0,0.06)

// Sidebar width
$sidebar-width                = 280
