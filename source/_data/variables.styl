// =====================================================================
// NexT Variable Override - Dark Purple Theme
// =====================================================================

// --- Force dark mode colors ---
$body-bg-color                = #0a0a0f
$body-bg-color-dark           = #0a0a0f
$content-bg-color             = #1a1a2e
$content-bg-color-dark        = #1a1a2e
$card-bg-color                = #1a1a2e
$card-bg-color-dark           = #1a1a2e

$text-color                   = #e2e8f0
$text-color-dark              = #e2e8f0
$link-color                   = #c084fc
$link-color-dark              = #c084fc
$link-hover-color             = #a855f7
$link-hover-color-dark        = #a855f7
$link-decoration-color        = rgba(168, 85, 247, 0.4)

$border-color                 = rgba(168, 85, 247, 0.15)

$selection-bg                 = #a855f7
$selection-color              = #fff

$menu-item-bg-color           = rgba(168, 85, 247, 0.1)
$menu-item-bg-color-dark      = rgba(168, 85, 247, 0.1)

$theme-color                  = #a855f7
$theme-color-dark             = #a855f7

$blockquote-color             = #94a3b8
$blockquote-color-dark        = #94a3b8

$table-border-color           = rgba(168, 85, 247, 0.15)
$table-row-odd-bg-color       = #12121a
$table-row-odd-bg-color-dark  = #12121a
$table-row-hover-bg-color     = #222240
$table-row-hover-bg-color-dark = #222240

// Brand
$brand-color                  = #c084fc
$brand-hover-color            = #e2e8f0
$brand-color-dark             = #c084fc
$brand-hover-color-dark       = #e2e8f0
$subtitle-color               = #94a3b8
$site-subtitle-color          = #94a3b8

// Sidebar
$sidebar-nav-color            = #94a3b8
$sidebar-nav-hover-color      = #c084fc
$sidebar-highlight            = #a855f7
$site-author-name-color       = #e2e8f0
$site-description-color       = #94a3b8
$site-state-item-name-color   = #64748b

// Buttons
$btn-default-bg               = rgba(168, 85, 247, 0.15)
$btn-default-bg-dark          = rgba(168, 85, 247, 0.15)
$btn-default-color            = #c084fc
$btn-default-color-dark       = #c084fc
$btn-default-border-color     = rgba(168, 85, 247, 0.3)
$btn-default-border-color-dark = rgba(168, 85, 247, 0.3)
$btn-default-hover-bg         = rgba(168, 85, 247, 0.25)
$btn-default-hover-bg-dark    = rgba(168, 85, 247, 0.25)
$btn-default-hover-color      = #e2e8f0
$btn-default-hover-color-dark = #e2e8f0
$btn-default-hover-border-color = #a855f7
$btn-default-hover-border-color-dark = #a855f7
$btn-default-radius           = 8px

// Pagination
$pagination-link-bg           = #1a1a2e
$pagination-link-color        = #94a3b8
$pagination-link-border       = rgba(168, 85, 247, 0.15)
$pagination-link-hover-bg     = rgba(168, 85, 247, 0.15)
$pagination-link-hover-color  = #c084fc
$pagination-link-hover-border = #a855f7
$pagination-active-bg         = rgba(168, 85, 247, 0.2)
$pagination-active-color      = #c084fc
$pagination-active-border     = #a855f7

// Headband
$headband-bg                  = linear-gradient(90deg, #7c3aed, #a855f7, #7c3aed)

// Tag cloud
$tag-cloud-start              = #94a3b8
$tag-cloud-end                = #a855f7
$tag-cloud-start-dark         = #94a3b8
$tag-cloud-end-dark           = #c084fc

// Back to top
$b2t-bg-color                 = #1a1a2e
$b2t-color                    = #c084fc

// Badge
$badge-background             = rgba(168, 85, 247, 0.2)
$badge-color                  = #c084fc

// Layout
$content-desktop-large        = 800px
$content-desktop-largest      = 860px

// Border radius (for Pisces)
$border-radius-inner          = 16px
$border-radius                = 16px
$box-shadow-inner             = 0 8px 32px rgba(0,0,0,0.4)
$box-shadow                   = 0 8px 32px rgba(0,0,0,0.4)

// Sidebar width
$sidebar-width                = 280
