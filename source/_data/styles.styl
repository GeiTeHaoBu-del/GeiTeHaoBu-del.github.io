// =====================================================================
// Sage Green Theme - Style Enhancements (Light + Dark)
// =====================================================================

// --- Hide site-brand-container (header block) ---
.site-brand-container
  display: none !important

// --- Hide default sidebar site-overview (replaced by custom profile card) ---
.site-author
  display: none !important

.site-state-wrap
  display: none !important

.links-of-author
  display: none !important

// --- Three-column layout for desktop ---
.main
  gap: 16px

.main-inner
  flex: 1
  min-width: 0

.right-sidebar
  flex-shrink: 0
  width: 280px

// =====================================================================
// Custom Card Base (shared light styles)
// =====================================================================

$sage-50 = rgba(45, 106, 79, 0.06)
$sage-100 = rgba(45, 106, 79, 0.1)
$sage-200 = rgba(45, 106, 79, 0.2)
$sage-border = rgba(0, 0, 0, 0.08)
$sage-border-hover = rgba(45, 106, 79, 0.2)
$sage-text = #2d6a4f
$sage-text-light = #1b4332
$text-primary = #1b2e1f
$text-secondary = #6b7c6f
$text-muted = #95a89a
$bg-card = #ffffff
$bg-deep = #f8f7f4
$bg-input = #fafaf8
// --- Left Profile Card ---
.left-profile-card
  background: var(--card-bg, $bg-card)
  border: 1px solid var(--card-border, $sage-border)
  border-radius: 8px
  padding: 24px 20px
  text-align: center
  margin-bottom: 20px
  transition: border-color 0.3s ease
  &:hover
    border-color: var(--card-border-hover, $sage-border-hover)

  .profile-avatar
    width: 80px
    height: 80px
    border-radius: 50%
    border: 2px solid var(--accent, $sage-text)
    margin: 0 auto 12px
    display: block
    transition: transform 0.3s ease
    &:hover
      transform: scale(1.03)

  .profile-name
    font-size: 1.15em
    font-weight: 700
    color: var(--text-primary, $text-primary)
    margin-bottom: 2px

  .profile-handle
    font-size: 0.82em
    color: $text-secondary
    margin-bottom: 10px
    a
      color: var(--accent, $sage-text)
      text-decoration: none
      &:hover
        text-decoration: underline

  .profile-bio
    font-size: 0.8em
    color: $text-muted
    line-height: 1.5
    margin-bottom: 12px

  .profile-stats
    display: flex
    justify-content: center
    gap: 20px
    margin-bottom: 12px
    padding: 10px 0
    border-top: 1px solid var(--card-border, $sage-border)
    border-bottom: 1px solid var(--card-border, $sage-border)
    .stat-item
      text-align: center
      .stat-num
        font-size: 1em
        font-weight: 700
        color: var(--text-primary, $text-primary)
      .stat-label
        font-size: 0.7em
        color: $text-secondary

  .profile-social
    display: flex
    justify-content: center
    gap: 10px
    a
      display: flex
      align-items: center
      justify-content: center
      width: 32px
      height: 32px
      border-radius: 50%
      background: var(--bg-deep, $bg-deep)
      border: 1px solid var(--card-border, $sage-border)
      color: $text-muted
      transition: all 0.3s ease
      &:hover
        background: var(--accent-bg, $sage-100)
        border-color: var(--accent, $sage-text)
        color: var(--accent, $sage-text)
// --- Left Tech Card ---
.left-tech-card
  background: var(--card-bg, $bg-card)
  border: 1px solid var(--card-border, $sage-border)
  border-radius: 8px
  padding: 16px
  margin-bottom: 20px
  transition: border-color 0.3s ease
  &:hover
    border-color: var(--card-border-hover, $sage-border-hover)

  .card-title
    font-size: 0.85em
    font-weight: 700
    color: var(--accent, $sage-text)
    margin-bottom: 10px
    display: flex
    align-items: center
    gap: 6px

  .tech-tags
    display: flex
    flex-wrap: wrap
    gap: 5px
    .tech-tag
      display: inline-block
      padding: 2px 10px
      background: var(--accent-bg, $sage-50)
      color: var(--accent, $sage-text)
      border-radius: 4px
      font-size: 0.78em
      border: 1px solid var(--card-border, $sage-border)
      transition: all 0.3s ease
      &:hover
        background: var(--accent-bg-hover, $sage-100)
        border-color: var(--accent, $sage-text)

// --- Left Progress Card ---
.left-progress-card
  background: var(--card-bg, $bg-card)
  border: 1px solid var(--card-border, $sage-border)
  border-radius: 8px
  padding: 16px
  margin-bottom: 20px
  transition: border-color 0.3s ease
  &:hover
    border-color: var(--card-border-hover, $sage-border-hover)

  .card-title
    font-size: 0.85em
    font-weight: 700
    color: var(--accent, $sage-text)
    margin-bottom: 10px
    display: flex
    align-items: center
    gap: 6px

  .progress-item
    margin-bottom: 8px
    .progress-label
      display: flex
      justify-content: space-between
      font-size: 0.75em
      color: $text-muted
      margin-bottom: 3px
    .progress-bar
      height: 4px
      background: var(--bg-deep, $bg-deep)
      border-radius: 2px
      overflow: hidden
      .progress-fill
        height: 100%
        background: linear-gradient(90deg, #1b4332, #2d6a4f)
        border-radius: 2px
// --- Top Nav Bar ---
.top-nav-bar
  background: var(--card-bg, $bg-card)
  border: 1px solid var(--card-border, $sage-border)
  border-radius: 8px
  padding: 12px 20px
  margin-bottom: 20px
  display: flex
  align-items: center
  justify-content: space-between
  flex-wrap: wrap
  gap: 8px
  box-shadow: 0 1px 4px rgba(0,0,0,0.04)
  &:hover
    border-color: var(--card-border-hover, $sage-border-hover)

  .nav-brand
    font-size: 1.1em
    font-weight: 700
    a
      color: var(--accent, $sage-text) !important
      text-decoration: none

  .nav-menu
    display: flex
    gap: 6px
    flex-wrap: wrap
    .nav-item
      padding: 5px 14px
      color: $text-muted
      font-size: 0.82em
      text-decoration: none
      border-radius: 6px
      border: 1px solid transparent
      transition: all 0.3s ease
      &:hover, &.nav-active
        color: var(--accent, $sage-text)
        background: var(--accent-bg, $sage-50)
        border-color: var(--accent, $sage-text)

// --- Post Filter Bar ---
.post-filter-bar
  background: var(--card-bg, $bg-card)
  border: 1px solid var(--card-border, $sage-border)
  border-radius: 8px
  padding: 14px 20px
  margin-bottom: 20px
  display: flex
  align-items: center
  gap: 8px
  flex-wrap: wrap
  justify-content: flex-start
  box-shadow: 0 1px 4px rgba(0,0,0,0.04)
  &:hover
    border-color: var(--card-border-hover, $sage-border-hover)

  .filter-label
    font-size: 0.82em
    color: $text-secondary

  .filter-tag
    padding: 4px 12px
    background: var(--bg-deep, $bg-deep)
    color: $text-muted
    border: 1px solid var(--card-border, $sage-border)
    border-radius: 4px
    font-size: 0.78em
    cursor: pointer
    transition: all 0.3s ease
    &:hover, &.active
      background: var(--accent-bg, $sage-50)
      color: var(--accent, $sage-text)
      border-color: var(--accent, $sage-text)
// --- Right Sidebar ---
.right-sidebar
  background: var(--card-bg, $bg-card)
  border: 1px solid var(--card-border, $sage-border)
  border-radius: 8px
  box-shadow: 0 1px 4px rgba(0,0,0,0.04)

.right-stats-card
  background: var(--card-bg, $bg-card)
  border: 1px solid var(--card-border, $sage-border)
  border-radius: 8px
  padding: 16px
  margin-bottom: 20px
  transition: border-color 0.3s ease
  &:hover
    border-color: var(--card-border-hover, $sage-border-hover)

  .card-title
    font-size: 0.85em
    font-weight: 700
    color: var(--accent, $sage-text)
    margin-bottom: 12px
    display: flex
    align-items: center
    gap: 6px

  .stats-grid
    display: grid
    grid-template-columns: 1fr 1fr
    gap: 10px
    .stats-item
      text-align: center
      padding: 10px 6px
      background: var(--bg-deep, $bg-deep)
      border-radius: 6px
      border: 1px solid var(--card-border, $sage-border)
      .stats-num
        font-size: 1.2em
        font-weight: 700
        color: var(--accent, $sage-text)
      .stats-label
        font-size: 0.65em
        color: $text-secondary
        margin-top: 2px

.right-tree-card
  background: var(--card-bg, $bg-card)
  border: 1px solid var(--card-border, $sage-border)
  border-radius: 8px
  padding: 16px
  margin-bottom: 20px
  transition: border-color 0.3s ease
  &:hover
    border-color: var(--card-border-hover, $sage-border-hover)

  .card-title
    font-size: 0.85em
    font-weight: 700
    color: var(--accent, $sage-text)
    margin-bottom: 12px
    display: flex
    align-items: center
    gap: 6px

  .tree-list
    list-style: none
    padding: 0
    margin: 0
    .tree-category
      margin-bottom: 6px
      .tree-cat-header
        display: flex
        align-items: center
        gap: 6px
        padding: 5px 8px
        border-radius: 6px
        cursor: pointer
        transition: all 0.3s ease
        .tree-icon
          color: var(--accent, $sage-text)
          font-size: 0.8em
        .tree-cat-name
          font-size: 0.8em
          font-weight: 600
          color: var(--text-primary, $text-primary)
        .tree-cat-count
          font-size: 0.65em
          color: $text-secondary
          margin-left: auto
          background: var(--bg-deep, $bg-deep)
          padding: 1px 6px
          border-radius: 4px
        &:hover
          background: var(--accent-bg, $sage-50)
      .tree-posts
        list-style: none
        padding: 0 0 0 24px
        margin: 0
        .tree-post-item
          margin: 0
          padding: 0
          a
            display: flex
            align-items: center
            gap: 5px
            padding: 2px 6px
            font-size: 0.75em
            color: $text-muted
            text-decoration: none
            border-radius: 6px
            transition: all 0.3s ease
            &:hover
              color: var(--accent, $sage-text)
              background: var(--accent-bg, $sage-50)
            .tree-dot
              width: 3px
              height: 3px
              border-radius: 50%
              background: var(--accent, $sage-text)
// --- Main content: left-aligned ---
.main-inner
  text-align: left

.posts-expand .post-header
  margin-bottom: 16px
  text-align: left

.posts-expand .post-title
  font-size: 1.15em
  font-weight: 600
  text-align: left

.posts-expand .post-meta-container
  font-size: 0.8em
  margin-top: 4px
  text-align: left

  .post-meta
    justify-content: flex-start

  .post-description
    font-size: 0.85em
    color: $text-muted
    margin-top: 6px
    text-align: left

.posts-expand .post-body
  font-size: 0.9em
  line-height: 1.6
  text-align: left

  p
    margin-bottom: 8px

.post-button
  text-align: left
  margin-top: 4px

  .btn
    border: none !important
    background: none !important
    padding: 0 !important
    font-size: 0.85em
    color: var(--accent, $sage-text)
    &:hover
      color: var(--accent-hover, $sage-text-light)
      background: none !important
      border: none !important

// --- Post eof: visible divider ---
.post-eof
  background: var(--card-border, $sage-border) !important
  height: 2px !important
  width: 80% !important
  margin: 48px auto 48px !important

// --- Post button (read more) ---
.post-button .btn
  font-size: 0.85em

// --- Scrollbar ---
::-webkit-scrollbar
  width: 6px
::-webkit-scrollbar-track
  background: var(--bg-deep, $bg-deep)
::-webkit-scrollbar-thumb
  background: #d6d3d1
  border-radius: 3px
::-webkit-scrollbar-thumb:hover
  background: $sage-text

// --- Reading Progress ---
.reading-progress-bar
  background: linear-gradient(90deg, #1b4332, #2d6a4f) !important

// --- Search popup ---
.search-pop-overlay
  background: rgba(0, 0, 0, 0.4) !important

.search-popup
  background: var(--card-bg, $bg-card) !important
  border: 1px solid var(--card-border, $sage-border) !important

.search-popup .search-input
  background: var(--bg-deep, $bg-deep) !important
  color: var(--text-primary, $text-primary) !important
// =====================================================================
// Dark mode overrides
// =====================================================================
html[data-theme="dark"]
  // Override NexT CSS variables
  --body-bg-color: #141a17
  --content-bg-color: #1e2522
  --card-bg-color: #1e2522
  --text-color: #d8e8dc
  --link-color: #52b788
  --link-hover-color: #74c69d
  --brand-color: #52b788
  --brand-hover-color: #74c69d
  --menu-item-bg-color: rgba(82, 183, 136, 0.08)
  --theme-color: #52b788
  --blockquote-color: #95a89a
  --table-row-odd-bg-color: #141a17
  --table-row-hover-bg-color: #2a332e
  --btn-default-bg: rgba(82, 183, 136, 0.08)
  --btn-default-color: #52b788
  --btn-default-border-color: rgba(82, 183, 136, 0.2)
  --btn-default-hover-bg: rgba(82, 183, 136, 0.15)
  --btn-default-hover-color: #74c69d
  --btn-default-hover-border-color: #52b788
  color-scheme: dark

  // Force sidebar & header dark
  .sidebar-inner
    background: #1e2522 !important
    color: #d8e8dc !important
  .header
    background: #1e2522 !important
  .column
    background: #1e2522 !important
  .sidebar-nav .sidebar-nav-link
    color: #95a89a !important

  .left-profile-card
    background: #1e2522 !important
    border-color: rgba(82, 183, 136, 0.1) !important
    &:hover
      border-color: rgba(82, 183, 136, 0.3) !important
    .profile-avatar
      border-color: #52b788 !important
    .profile-name
      color: #d8e8dc !important
    .profile-bio
      color: #95a89a !important
    .profile-handle a
      color: #52b788 !important
    .profile-stats
      border-top-color: rgba(82, 183, 136, 0.1) !important
      border-bottom-color: rgba(82, 183, 136, 0.1) !important
      .stat-num
        color: #d8e8dc !important
      .stat-label
        color: #6b7c6f !important
    .profile-social a
      background: #141a17 !important
      border-color: rgba(82, 183, 136, 0.1) !important
      color: #95a89a !important
      &:hover
        background: rgba(82, 183, 136, 0.1) !important
        border-color: #52b788 !important
        color: #52b788 !important

  .left-tech-card
    background: #1e2522 !important
    border-color: rgba(82, 183, 136, 0.1) !important
    &:hover
      border-color: rgba(82, 183, 136, 0.3) !important
    .card-title
      color: #52b788 !important
    .tech-tag
      background: rgba(82, 183, 136, 0.08) !important
      color: #52b788 !important
      border-color: rgba(82, 183, 136, 0.15) !important
      &:hover
        background: rgba(82, 183, 136, 0.15) !important
        border-color: #52b788 !important

  .left-progress-card
    background: #1e2522 !important
    border-color: rgba(82, 183, 136, 0.1) !important
    &:hover
      border-color: rgba(82, 183, 136, 0.3) !important
    .card-title
      color: #52b788 !important
    .progress-label
      color: #95a89a !important
    .progress-bar
      background: #141a17 !important
    .progress-fill
      background: linear-gradient(90deg, #1b4332, #2d6a4f) !important

  .top-nav-bar
    background: #1e2522
    border-color: rgba(82, 183, 136, 0.1)
    box-shadow: 0 1px 4px rgba(0,0,0,0.1)
    &:hover
      border-color: rgba(82, 183, 136, 0.3)
    .nav-brand a
      color: #52b788 !important
    .nav-item
      &:hover, &.nav-active
        color: #52b788
        background: rgba(82, 183, 136, 0.08)
        border-color: #52b788

  .post-filter-bar
    background: #1e2522
    border-color: rgba(82, 183, 136, 0.1)
    box-shadow: 0 1px 4px rgba(0,0,0,0.1)
    &:hover
      border-color: rgba(82, 183, 136, 0.3)
    .filter-tag
      background: #141a17
      border-color: rgba(82, 183, 136, 0.1)
      &:hover, &.active
        background: rgba(82, 183, 136, 0.08)
        color: #52b788
        border-color: #52b788

  .right-sidebar
    background: #1e2522
    border-color: rgba(82, 183, 136, 0.1)
    box-shadow: 0 1px 4px rgba(0,0,0,0.1)

  .right-stats-card,
  .right-tree-card
    background: #1e2522
    border-color: rgba(82, 183, 136, 0.1)
    &:hover
      border-color: rgba(82, 183, 136, 0.3)
    .card-title
      color: #52b788

  .right-stats-card .stats-item
    background: #141a17
    border-color: rgba(82, 183, 136, 0.1)
    .stats-num
      color: #52b788

  .right-tree-card
    .tree-cat-header
      .tree-icon
        color: #52b788 !important
      .tree-cat-name
        color: #d8e8dc !important
      .tree-cat-count
        background: #141a17 !important
        color: #95a89a !important
      &:hover
        background: rgba(82, 183, 136, 0.08) !important
    .tree-post-item a
      color: #95a89a !important
      &:hover
        color: #52b788 !important
        background: rgba(82, 183, 136, 0.08) !important
      .tree-dot
        background: #52b788 !important

  .post-eof
    background: rgba(82, 183, 136, 0.15) !important

  .post-button .btn
    color: #52b788
    &:hover
      color: #74c69d

  .reading-progress-bar
    background: linear-gradient(90deg, #1b4332, #2d6a4f) !important

  .search-popup
    background: #1e2522 !important
    border-color: rgba(82, 183, 136, 0.1) !important
  .search-popup .search-input
    background: #141a17 !important
    color: #d8e8dc !important

  ::-webkit-scrollbar-track
    background: #141a17
  ::-webkit-scrollbar-thumb
    background: #2a332e
  ::-webkit-scrollbar-thumb:hover
    background: #52b788
// --- Theme Toggle Button ---
.theme-toggle
  position: fixed
  bottom: 30px
  right: 30px
  z-index: 9999
  width: 44px
  height: 44px
  border-radius: 50%
  border: 1px solid $sage-border
  background: $bg-card
  color: $sage-text
  font-size: 1.1em
  cursor: pointer
  box-shadow: 0 1px 4px rgba(0,0,0,0.06)
  transition: all 0.3s ease
  display: flex
  align-items: center
  justify-content: center
  &:hover
    border-color: $sage-text
    box-shadow: 0 2px 8px rgba(45, 106, 79, 0.15)
    transform: scale(1.05)

html[data-theme="dark"]
  .theme-toggle
    background: #1e2522
    border-color: rgba(82, 183, 136, 0.15)
    color: #52b788
    box-shadow: 0 1px 4px rgba(0,0,0,0.1)
    &:hover
      border-color: #52b788
      box-shadow: 0 2px 8px rgba(82, 183, 136, 0.2)

// --- Responsive ---
@media (max-width: 1200px)
  .right-sidebar
    display: none !important

@media (max-width: 900px)
  .right-sidebar
    display: none !important
  .posts-expand .post-title
    font-size: 1.05em
