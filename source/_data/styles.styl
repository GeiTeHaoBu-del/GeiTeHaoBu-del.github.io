// =====================================================================
// Dark Purple Theme - Style Enhancements (layout handled by Pisces)
// =====================================================================

// --- Sidebar custom cards ---
.left-profile-card
  background: #1a1a2e
  border: 1px solid rgba(168, 85, 247, 0.15)
  border-radius: 16px
  padding: 24px 20px
  text-align: center
  margin-bottom: 20px
  transition: all 0.3s ease
  &:hover
    border-color: rgba(168, 85, 247, 0.4)
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5), 0 0 20px rgba(168, 85, 247, 0.3)
    transform: translateY(-4px)

  .profile-avatar
    width: 100px
    height: 100px
    border-radius: 50%
    border: 2px solid #a855f7
    box-shadow: 0 0 16px rgba(168, 85, 247, 0.3)
    margin: 0 auto 12px
    display: block
    transition: all 0.3s ease
    &:hover
      box-shadow: 0 0 24px rgba(168, 85, 247, 0.5)
      transform: scale(1.05)

  .profile-name
    font-size: 1.15em
    font-weight: 700
    color: #e2e8f0
    margin-bottom: 2px

  .profile-handle
    font-size: 0.82em
    color: #64748b
    margin-bottom: 10px
    a
      color: #c084fc
      text-decoration: none
      &:hover
        text-decoration: underline

  .profile-bio
    font-size: 0.8em
    color: #94a3b8
    line-height: 1.5
    margin-bottom: 12px

  .profile-stats
    display: flex
    justify-content: center
    gap: 20px
    margin-bottom: 12px
    padding: 10px 0
    border-top: 1px solid rgba(168, 85, 247, 0.15)
    border-bottom: 1px solid rgba(168, 85, 247, 0.15)
    .stat-item
      text-align: center
      .stat-num
        font-size: 1em
        font-weight: 700
        color: #e2e8f0
      .stat-label
        font-size: 0.7em
        color: #64748b

  .profile-social
    display: flex
    justify-content: center
    gap: 10px
    a
      display: flex
      align-items: center
      justify-content: center
      width: 32px
      height: 32px
      border-radius: 50%
      background: #0a0a0f
      border: 1px solid rgba(168, 85, 247, 0.15)
      color: #94a3b8
      transition: all 0.3s ease
      &:hover
        background: rgba(168, 85, 247, 0.1)
        border-color: #a855f7
        color: #c084fc
        box-shadow: 0 0 8px rgba(168, 85, 247, 0.3)

.left-tech-card
  background: #1a1a2e
  border: 1px solid rgba(168, 85, 247, 0.15)
  border-radius: 16px
  padding: 16px
  margin-bottom: 20px
  transition: all 0.3s ease
  &:hover
    border-color: rgba(168, 85, 247, 0.4)
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5), 0 0 20px rgba(168, 85, 247, 0.3)
    transform: translateY(-4px)

  .card-title
    font-size: 0.85em
    font-weight: 700
    color: #c084fc
    margin-bottom: 10px
    display: flex
    align-items: center
    gap: 6px

  .tech-tags
    display: flex
    flex-wrap: wrap
    gap: 5px
    .tech-tag
      display: inline-block
      padding: 2px 10px
      background: rgba(168, 85, 247, 0.1)
      color: #c084fc
      border-radius: 20px
      font-size: 0.78em
      border: 1px solid rgba(168, 85, 247, 0.2)
      transition: all 0.3s ease
      &:hover
        background: rgba(168, 85, 247, 0.2)
        border-color: #a855f7

.left-progress-card
  background: #1a1a2e
  border: 1px solid rgba(168, 85, 247, 0.15)
  border-radius: 16px
  padding: 16px
  margin-bottom: 20px
  transition: all 0.3s ease
  &:hover
    border-color: rgba(168, 85, 247, 0.4)
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5), 0 0 20px rgba(168, 85, 247, 0.3)
    transform: translateY(-4px)

  .card-title
    font-size: 0.85em
    font-weight: 700
    color: #c084fc
    margin-bottom: 10px
    display: flex
    align-items: center
    gap: 6px

  .progress-item
    margin-bottom: 8px
    .progress-label
      display: flex
      justify-content: space-between
      font-size: 0.75em
      color: #94a3b8
      margin-bottom: 3px
    .progress-bar
      height: 5px
      background: #0a0a0f
      border-radius: 3px
      overflow: hidden
      .progress-fill
        height: 100%
        background: linear-gradient(90deg, #7c3aed, #a855f7)
        border-radius: 3px

// --- Top Nav Bar ---
.top-nav-bar
  background: #1a1a2e
  border: 1px solid rgba(168, 85, 247, 0.15)
  border-radius: 16px
  padding: 12px 20px
  margin-bottom: 20px
  display: flex
  align-items: center
  justify-content: space-between
  flex-wrap: wrap
  gap: 8px
  box-shadow: 0 8px 32px rgba(0,0,0,0.4)
  &:hover
    border-color: rgba(168, 85, 247, 0.4)

  .nav-brand
    font-size: 1.1em
    font-weight: 700
    a
      color: #c084fc !important
      text-decoration: none

  .nav-menu
    display: flex
    gap: 6px
    flex-wrap: wrap
    .nav-item
      padding: 5px 14px
      color: #94a3b8
      font-size: 0.82em
      text-decoration: none
      border-radius: 8px
      border: 1px solid transparent
      transition: all 0.3s ease
      &:hover, &.nav-active
        color: #c084fc
        background: rgba(168, 85, 247, 0.1)
        border-color: #a855f7

// --- Post Filter Bar ---
.post-filter-bar
  background: #1a1a2e
  border: 1px solid rgba(168, 85, 247, 0.15)
  border-radius: 16px
  padding: 14px 20px
  margin-bottom: 20px
  display: flex
  align-items: center
  gap: 8px
  flex-wrap: wrap
  box-shadow: 0 8px 32px rgba(0,0,0,0.4)
  &:hover
    border-color: rgba(168, 85, 247, 0.4)

  .filter-label
    font-size: 0.82em
    color: #64748b

  .filter-tag
    padding: 4px 12px
    background: #0a0a0f
    color: #94a3b8
    border: 1px solid rgba(168, 85, 247, 0.15)
    border-radius: 20px
    font-size: 0.78em
    cursor: pointer
    transition: all 0.3s ease
    &:hover, &.active
      background: rgba(168, 85, 247, 0.1)
      color: #c084fc
      border-color: #a855f7

// --- Right Sidebar ---
.right-sidebar
  width: 300px
  background: #1a1a2e
  border: 1px solid rgba(168, 85, 247, 0.15)
  border-radius: 16px
  box-shadow: 0 8px 32px rgba(0,0,0,0.4)

.right-stats-card
  background: #1a1a2e
  border: 1px solid rgba(168, 85, 247, 0.15)
  border-radius: 16px
  padding: 16px
  margin-bottom: 20px
  transition: all 0.3s ease
  &:hover
    border-color: rgba(168, 85, 247, 0.4)
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5), 0 0 20px rgba(168, 85, 247, 0.3)
    transform: translateY(-4px)

  .card-title
    font-size: 0.85em
    font-weight: 700
    color: #c084fc
    margin-bottom: 12px
    display: flex
    align-items: center
    gap: 6px

  .stats-grid
    display: grid
    grid-template-columns: 1fr 1fr
    gap: 10px
    .stats-item
      text-align: center
      padding: 10px 6px
      background: #0a0a0f
      border-radius: 8px
      border: 1px solid rgba(168, 85, 247, 0.15)
      .stats-num
        font-size: 1.2em
        font-weight: 700
        color: #c084fc
      .stats-label
        font-size: 0.65em
        color: #64748b
        margin-top: 2px

.right-tree-card
  background: #1a1a2e
  border: 1px solid rgba(168, 85, 247, 0.15)
  border-radius: 16px
  padding: 16px
  margin-bottom: 20px
  transition: all 0.3s ease
  &:hover
    border-color: rgba(168, 85, 247, 0.4)
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5), 0 0 20px rgba(168, 85, 247, 0.3)
    transform: translateY(-4px)

  .card-title
    font-size: 0.85em
    font-weight: 700
    color: #c084fc
    margin-bottom: 12px
    display: flex
    align-items: center
    gap: 6px

  .tree-list
    list-style: none
    padding: 0
    margin: 0
    .tree-category
      margin-bottom: 6px
      .tree-cat-header
        display: flex
        align-items: center
        gap: 6px
        padding: 5px 8px
        border-radius: 8px
        cursor: pointer
        transition: all 0.3s ease
        .tree-icon
          color: #a855f7
          font-size: 0.8em
        .tree-cat-name
          font-size: 0.8em
          font-weight: 600
          color: #e2e8f0
        .tree-cat-count
          font-size: 0.65em
          color: #64748b
          margin-left: auto
          background: #0a0a0f
          padding: 1px 6px
          border-radius: 20px
        &:hover
          background: rgba(168, 85, 247, 0.1)
      .tree-posts
        list-style: none
        padding: 0 0 0 24px
        .tree-post-item
          a
            display: flex
            align-items: center
            gap: 5px
            padding: 3px 6px
            font-size: 0.75em
            color: #94a3b8
            text-decoration: none
            border-radius: 8px
            transition: all 0.3s ease
            &:hover
              color: #c084fc
              background: rgba(168, 85, 247, 0.1)
            .tree-dot
              width: 3px
              height: 3px
              border-radius: 50%
              background: #a855f7

// --- Scrollbar ---
::-webkit-scrollbar
  width: 6px
::-webkit-scrollbar-track
  background: #0a0a0f
::-webkit-scrollbar-thumb
  background: #222240
  border-radius: 3px
::-webkit-scrollbar-thumb:hover
  background: #7c3aed

// --- Reading Progress ---
.reading-progress-bar
  background: linear-gradient(90deg, #7c3aed, #a855f7) !important

// --- Post cards floating effect ---
.posts-expand .post-block
  transition: all 0.3s ease
  &:hover
    transform: translateY(-4px)

// --- Search popup dark ---
.search-pop-overlay
  background: rgba(0, 0, 0, 0.6) !important

.search-popup
  background: #1a1a2e !important
  border: 1px solid rgba(168, 85, 247, 0.15) !important

.search-popup .search-input
  background: #0a0a0f !important
  color: #e2e8f0 !important

// --- Responsive: hide right sidebar on small screens ---
@media (max-width: 1200px)
  .right-sidebar
    display: none !important

@media (max-width: 900px)
  .right-sidebar
    display: none !important