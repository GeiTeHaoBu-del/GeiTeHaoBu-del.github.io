// =====================================================================
// Purple Theme - Style Enhancements (Light + Dark)
// =====================================================================

// --- Hide site-brand-container (purple header block) ---
.site-brand-container
  display: none !important

// --- Hide default sidebar site-overview (replaced by custom profile card) ---
.site-author
  display: none !important

.site-state-wrap
  display: none !important

.links-of-author
  display: none !important

// --- Three-column layout for desktop ---
.main
  gap: 16px

.main-inner
  flex: 1
  min-width: 0

.right-sidebar
  flex-shrink: 0
  width: 280px

// =====================================================================
// Custom Card Base (shared light styles)
// =====================================================================

$purple-50 = rgba(124, 58, 237, 0.06)
$purple-100 = rgba(124, 58, 237, 0.1)
$purple-200 = rgba(124, 58, 237, 0.2)
$purple-border = rgba(124, 58, 237, 0.12)
$purple-border-hover = rgba(124, 58, 237, 0.3)
$purple-text = #7c3aed
$purple-text-light = #6d28d9
$text-primary = #1e293b
$text-secondary = #64748b
$text-muted = #94a3b8
$bg-card = #ffffff
$bg-deep = #f0f1f5
$bg-input = #f5f6fa

// --- Left Profile Card ---
.left-profile-card
  background: var(--card-bg, $bg-card)
  border: 1px solid var(--card-border, $purple-border)
  border-radius: 16px
  padding: 24px 20px
  text-align: center
  margin-bottom: 20px
  transition: all 0.3s ease
  &:hover
    border-color: var(--card-border-hover, $purple-border-hover)
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08)
    transform: translateY(-4px)

  .profile-avatar
    width: 100px
    height: 100px
    border-radius: 50%
    border: 2px solid var(--accent, $purple-text)
    box-shadow: 0 0 12px rgba(124, 58, 237, 0.15)
    margin: 0 auto 12px
    display: block
    transition: all 0.3s ease
    &:hover
      box-shadow: 0 0 20px rgba(124, 58, 237, 0.25)
      transform: scale(1.05)

  .profile-name
    font-size: 1.15em
    font-weight: 700
    color: var(--text-primary, $text-primary)
    margin-bottom: 2px

  .profile-handle
    font-size: 0.82em
    color: $text-secondary
    margin-bottom: 10px
    a
      color: var(--accent, $purple-text)
      text-decoration: none
      &:hover
        text-decoration: underline

  .profile-bio
    font-size: 0.8em
    color: $text-muted
    line-height: 1.5
    margin-bottom: 12px

  .profile-stats
    display: flex
    justify-content: center
    gap: 20px
    margin-bottom: 12px
    padding: 10px 0
    border-top: 1px solid var(--card-border, $purple-border)
    border-bottom: 1px solid var(--card-border, $purple-border)
    .stat-item
      text-align: center
      .stat-num
        font-size: 1em
        font-weight: 700
        color: var(--text-primary, $text-primary)
      .stat-label
        font-size: 0.7em
        color: $text-secondary

  .profile-social
    display: flex
    justify-content: center
    gap: 10px
    a
      display: flex
      align-items: center
      justify-content: center
      width: 32px
      height: 32px
      border-radius: 50%
      background: var(--bg-deep, $bg-deep)
      border: 1px solid var(--card-border, $purple-border)
      color: $text-muted
      transition: all 0.3s ease
      &:hover
        background: var(--accent-bg, $purple-100)
        border-color: var(--accent, $purple-text)
        color: var(--accent, $purple-text)
        box-shadow: 0 0 8px rgba(124, 58, 237, 0.2)

// --- Left Tech Card ---
.left-tech-card
  background: var(--card-bg, $bg-card)
  border: 1px solid var(--card-border, $purple-border)
  border-radius: 16px
  padding: 16px
  margin-bottom: 20px
  transition: all 0.3s ease
  &:hover
    border-color: var(--card-border-hover, $purple-border-hover)
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08)
    transform: translateY(-4px)

  .card-title
    font-size: 0.85em
    font-weight: 700
    color: var(--accent, $purple-text)
    margin-bottom: 10px
    display: flex
    align-items: center
    gap: 6px

  .tech-tags
    display: flex
    flex-wrap: wrap
    gap: 5px
    .tech-tag
      display: inline-block
      padding: 2px 10px
      background: var(--accent-bg, $purple-100)
      color: var(--accent, $purple-text)
      border-radius: 20px
      font-size: 0.78em
      border: 1px solid var(--card-border, $purple-border)
      transition: all 0.3s ease
      &:hover
        background: var(--accent-bg-hover, $purple-200)
        border-color: var(--accent, $purple-text)

// --- Left Progress Card ---
.left-progress-card
  background: var(--card-bg, $bg-card)
  border: 1px solid var(--card-border, $purple-border)
  border-radius: 16px
  padding: 16px
  margin-bottom: 20px
  transition: all 0.3s ease
  &:hover
    border-color: var(--card-border-hover, $purple-border-hover)
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08)
    transform: translateY(-4px)

  .card-title
    font-size: 0.85em
    font-weight: 700
    color: var(--accent, $purple-text)
    margin-bottom: 10px
    display: flex
    align-items: center
    gap: 6px

  .progress-item
    margin-bottom: 8px
    .progress-label
      display: flex
      justify-content: space-between
      font-size: 0.75em
      color: $text-muted
      margin-bottom: 3px
    .progress-bar
      height: 5px
      background: var(--bg-deep, $bg-deep)
      border-radius: 3px
      overflow: hidden
      .progress-fill
        height: 100%
        background: linear-gradient(90deg, #6d28d9, #7c3aed)
        border-radius: 3px

// --- Top Nav Bar ---
.top-nav-bar
  background: var(--card-bg, $bg-card)
  border: 1px solid var(--card-border, $purple-border)
  border-radius: 16px
  padding: 12px 20px
  margin-bottom: 20px
  display: flex
  align-items: center
  justify-content: space-between
  flex-wrap: wrap
  gap: 8px
  box-shadow: 0 4px 16px rgba(0,0,0,0.06)
  &:hover
    border-color: var(--card-border-hover, $purple-border-hover)

  .nav-brand
    font-size: 1.1em
    font-weight: 700
    a
      color: var(--accent, $purple-text) !important
      text-decoration: none

  .nav-menu
    display: flex
    gap: 6px
    flex-wrap: wrap
    .nav-item
      padding: 5px 14px
      color: $text-muted
      font-size: 0.82em
      text-decoration: none
      border-radius: 8px
      border: 1px solid transparent
      transition: all 0.3s ease
      &:hover, &.nav-active
        color: var(--accent, $purple-text)
        background: var(--accent-bg, $purple-100)
        border-color: var(--accent, $purple-text)

// --- Post Filter Bar ---
.post-filter-bar
  background: var(--card-bg, $bg-card)
  border: 1px solid var(--card-border, $purple-border)
  border-radius: 16px
  padding: 14px 20px
  margin-bottom: 20px
  display: flex
  align-items: center
  gap: 8px
  flex-wrap: wrap
  justify-content: flex-start
  box-shadow: 0 4px 16px rgba(0,0,0,0.06)
  &:hover
    border-color: var(--card-border-hover, $purple-border-hover)

  .filter-label
    font-size: 0.82em
    color: $text-secondary

  .filter-tag
    padding: 4px 12px
    background: var(--bg-deep, $bg-deep)
    color: $text-muted
    border: 1px solid var(--card-border, $purple-border)
    border-radius: 20px
    font-size: 0.78em
    cursor: pointer
    transition: all 0.3s ease
    &:hover, &.active
      background: var(--accent-bg, $purple-100)
      color: var(--accent, $purple-text)
      border-color: var(--accent, $purple-text)

// --- Right Sidebar ---
.right-sidebar
  background: var(--card-bg, $bg-card)
  border: 1px solid var(--card-border, $purple-border)
  border-radius: 16px
  box-shadow: 0 4px 16px rgba(0,0,0,0.06)

.right-stats-card
  background: var(--card-bg, $bg-card)
  border: 1px solid var(--card-border, $purple-border)
  border-radius: 16px
  padding: 16px
  margin-bottom: 20px
  transition: all 0.3s ease
  &:hover
    border-color: var(--card-border-hover, $purple-border-hover)
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08)
    transform: translateY(-4px)

  .card-title
    font-size: 0.85em
    font-weight: 700
    color: var(--accent, $purple-text)
    margin-bottom: 12px
    display: flex
    align-items: center
    gap: 6px

  .stats-grid
    display: grid
    grid-template-columns: 1fr 1fr
    gap: 10px
    .stats-item
      text-align: center
      padding: 10px 6px
      background: var(--bg-deep, $bg-deep)
      border-radius: 8px
      border: 1px solid var(--card-border, $purple-border)
      .stats-num
        font-size: 1.2em
        font-weight: 700
        color: var(--accent, $purple-text)
      .stats-label
        font-size: 0.65em
        color: $text-secondary
        margin-top: 2px

.right-tree-card
  background: var(--card-bg, $bg-card)
  border: 1px solid var(--card-border, $purple-border)
  border-radius: 16px
  padding: 16px
  margin-bottom: 20px
  transition: all 0.3s ease
  &:hover
    border-color: var(--card-border-hover, $purple-border-hover)
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08)
    transform: translateY(-4px)

  .card-title
    font-size: 0.85em
    font-weight: 700
    color: var(--accent, $purple-text)
    margin-bottom: 12px
    display: flex
    align-items: center
    gap: 6px

  .tree-list
    list-style: none
    padding: 0
    margin: 0
    .tree-category
      margin-bottom: 6px
      .tree-cat-header
        display: flex
        align-items: center
        gap: 6px
        padding: 5px 8px
        border-radius: 8px
        cursor: pointer
        transition: all 0.3s ease
        .tree-icon
          color: var(--accent, $purple-text)
          font-size: 0.8em
        .tree-cat-name
          font-size: 0.8em
          font-weight: 600
          color: var(--text-primary, $text-primary)
        .tree-cat-count
          font-size: 0.65em
          color: $text-secondary
          margin-left: auto
          background: var(--bg-deep, $bg-deep)
          padding: 1px 6px
          border-radius: 20px
        &:hover
          background: var(--accent-bg, $purple-100)
      .tree-posts
        list-style: none
        padding: 0 0 0 24px
        margin: 0
        .tree-post-item
          margin: 0
          padding: 0
          a
            display: flex
            align-items: center
            gap: 5px
            padding: 2px 6px
            font-size: 0.75em
            color: $text-muted
            text-decoration: none
            border-radius: 8px
            transition: all 0.3s ease
            &:hover
              color: var(--accent, $purple-text)
              background: var(--accent-bg, $purple-100)
            .tree-dot
              width: 3px
              height: 3px
              border-radius: 50%
              background: var(--accent, $purple-text)

// --- Main content: left-aligned ---
.main-inner
  text-align: left

.posts-expand .post-header
  margin-bottom: 16px
  text-align: left

.posts-expand .post-title
  font-size: 1.15em
  font-weight: 600
  text-align: left

.posts-expand .post-meta-container
  font-size: 0.8em
  margin-top: 4px
  text-align: left

  .post-meta
    justify-content: flex-start

  .post-description
    font-size: 0.85em
    color: $text-muted
    margin-top: 6px
    text-align: left

.posts-expand .post-body
  font-size: 0.9em
  line-height: 1.6
  text-align: left

  p
    margin-bottom: 8px

.post-button
  text-align: left
  margin-top: 4px

  .btn
    border: none !important
    background: none !important
    padding: 0 !important
    font-size: 0.85em
    color: var(--accent, $purple-text)
    &:hover
      color: var(--accent-hover, $purple-text-light)
      background: none !important
      border: none !important

// --- Post eof: visible divider ---
.post-eof
  background: var(--card-border, $purple-border) !important
  height: 2px !important
  width: 80% !important
  margin: 48px auto 48px !important

// --- Post button (read more) ---
.post-button .btn
  font-size: 0.85em

// --- Scrollbar ---
::-webkit-scrollbar
  width: 6px
::-webkit-scrollbar-track
  background: var(--bg-deep, $bg-deep)
::-webkit-scrollbar-thumb
  background: #ccc
  border-radius: 3px
::-webkit-scrollbar-thumb:hover
  background: $purple-text

// --- Reading Progress ---
.reading-progress-bar
  background: linear-gradient(90deg, #6d28d9, #7c3aed) !important

// --- Search popup ---
.search-pop-overlay
  background: rgba(0, 0, 0, 0.4) !important

.search-popup
  background: var(--card-bg, $bg-card) !important
  border: 1px solid var(--card-border, $purple-border) !important

.search-popup .search-input
  background: var(--bg-deep, $bg-deep) !important
  color: var(--text-primary, $text-primary) !important

// =====================================================================
// Dark mode overrides
// =====================================================================
html[data-theme="dark"]
  // Override NexT CSS variables
  --body-bg-color: #0a0a0f
  --content-bg-color: #1a1a2e
  --card-bg-color: #1a1a2e
  --text-color: #e2e8f0
  --link-color: #c084fc
  --link-hover-color: #a855f7
  --brand-color: #c084fc
  --brand-hover-color: #e2e8f0
  --menu-item-bg-color: rgba(168, 85, 247, 0.1)
  --theme-color: #a855f7
  --blockquote-color: #94a3b8
  --table-row-odd-bg-color: #12121a
  --table-row-hover-bg-color: #222240
  --btn-default-bg: rgba(168, 85, 247, 0.15)
  --btn-default-color: #c084fc
  --btn-default-border-color: rgba(168, 85, 247, 0.3)
  --btn-default-hover-bg: rgba(168, 85, 247, 0.25)
  --btn-default-hover-color: #e2e8f0
  --btn-default-hover-border-color: #a855f7
  color-scheme: dark

  // Force sidebar & header dark
  .sidebar-inner
    background: #1a1a2e !important
    color: #e2e8f0 !important
  .header
    background: #1a1a2e !important
  .column
    background: #1a1a2e !important
  .sidebar-nav .sidebar-nav-link
    color: #94a3b8 !important

  .left-profile-card,
  .left-tech-card,
  .left-progress-card,
    background: #1a1a2e
    border-color: rgba(168, 85, 247, 0.15)
    &:hover
      border-color: rgba(168, 85, 247, 0.4)
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5), 0 0 20px rgba(168, 85, 247, 0.3)

  .left-profile-card
    .profile-avatar
      border-color: #a855f7
      box-shadow: 0 0 16px rgba(168, 85, 247, 0.3)
      &:hover
        box-shadow: 0 0 24px rgba(168, 85, 247, 0.5)
    .profile-name
      color: #e2e8f0
    .profile-handle a
      color: #c084fc
    .profile-stats
      border-top-color: rgba(168, 85, 247, 0.15)
      border-bottom-color: rgba(168, 85, 247, 0.15)
      .stat-num
        color: #e2e8f0
    .profile-social a
      background: #0a0a0f
      border-color: rgba(168, 85, 247, 0.15)
      &:hover
        background: rgba(168, 85, 247, 0.1)
        border-color: #a855f7
        color: #c084fc
        box-shadow: 0 0 8px rgba(168, 85, 247, 0.3)

  .left-tech-card
    .card-title
      color: #c084fc
    .tech-tag
      background: rgba(168, 85, 247, 0.1)
      color: #c084fc
      border-color: rgba(168, 85, 247, 0.2)
      &:hover
        background: rgba(168, 85, 247, 0.2)
        border-color: #a855f7

  .left-progress-card
    .card-title
      color: #c084fc
    .progress-bar
      background: #0a0a0f
    .progress-fill
      background: linear-gradient(90deg, #7c3aed, #a855f7)

  .top-nav-bar
    background: #1a1a2e
    border-color: rgba(168, 85, 247, 0.15)
    box-shadow: 0 8px 32px rgba(0,0,0,0.4)
    &:hover
      border-color: rgba(168, 85, 247, 0.4)
    .nav-brand a
      color: #c084fc !important
    .nav-item
      &:hover, &.nav-active
        color: #c084fc
        background: rgba(168, 85, 247, 0.1)
        border-color: #a855f7

  .post-filter-bar
    background: #1a1a2e
    border-color: rgba(168, 85, 247, 0.15)
    box-shadow: 0 8px 32px rgba(0,0,0,0.4)
    &:hover
      border-color: rgba(168, 85, 247, 0.4)
    .filter-tag
      background: #0a0a0f
      border-color: rgba(168, 85, 247, 0.15)
      &:hover, &.active
        background: rgba(168, 85, 247, 0.1)
        color: #c084fc
        border-color: #a855f7

  .right-sidebar
    background: #1a1a2e
    border-color: rgba(168, 85, 247, 0.15)
    box-shadow: 0 8px 32px rgba(0,0,0,0.4)

  .right-stats-card,
  .right-tree-card
    background: #1a1a2e
    border-color: rgba(168, 85, 247, 0.15)
    &:hover
      border-color: rgba(168, 85, 247, 0.4)
      box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5), 0 0 20px rgba(168, 85, 247, 0.3)
    .card-title
      color: #c084fc

  .right-stats-card .stats-item
    background: #0a0a0f
    border-color: rgba(168, 85, 247, 0.15)
    .stats-num
      color: #c084fc

  .right-tree-card
    .tree-cat-header
      .tree-icon
        color: #a855f7
      .tree-cat-name
        color: #e2e8f0
      .tree-cat-count
        background: #0a0a0f
      &:hover
        background: rgba(168, 85, 247, 0.1)
    .tree-post-item a
      &:hover
        color: #c084fc
        background: rgba(168, 85, 247, 0.1)
      .tree-dot
        background: #a855f7

  .post-eof
    background: rgba(168, 85, 247, 0.25) !important

  .post-button .btn
    color: #c084fc
    &:hover
      color: #a855f7

  .reading-progress-bar
    background: linear-gradient(90deg, #7c3aed, #a855f7) !important

  .search-popup
    background: #1a1a2e !important
    border-color: rgba(168, 85, 247, 0.15) !important
  .search-popup .search-input
    background: #0a0a0f !important
    color: #e2e8f0 !important

  ::-webkit-scrollbar-track
    background: #0a0a0f
  ::-webkit-scrollbar-thumb
    background: #222240
  ::-webkit-scrollbar-thumb:hover
    background: #7c3aed

// --- Theme Toggle Button ---
.theme-toggle
  position: fixed
  bottom: 30px
  right: 30px
  z-index: 9999
  width: 44px
  height: 44px
  border-radius: 50%
  border: 1px solid $purple-border
  background: $bg-card
  color: $purple-text
  font-size: 1.1em
  cursor: pointer
  box-shadow: 0 4px 16px rgba(0,0,0,0.1)
  transition: all 0.3s ease
  display: flex
  align-items: center
  justify-content: center
  &:hover
    border-color: $purple-text
    box-shadow: 0 4px 20px rgba(124, 58, 237, 0.2)
    transform: scale(1.1)

html[data-theme="dark"]
  .theme-toggle
    background: #1a1a2e
    border-color: rgba(168, 85, 247, 0.2)
    color: #c084fc
    box-shadow: 0 4px 16px rgba(0,0,0,0.4)
    &:hover
      border-color: #a855f7
      box-shadow: 0 4px 20px rgba(168, 85, 247, 0.3)

// --- Responsive ---
@media (max-width: 1200px)
  .right-sidebar
    display: none !important

@media (max-width: 900px)
  .right-sidebar
    display: none !important
  .posts-expand .post-title
    font-size: 1.05em